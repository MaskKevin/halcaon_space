<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.1" halcon_version="12.0">
<procedure name="main">
<interface/>
<body>
<c as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[1,1]" as_ord="1">* Image Acquisition 01: Code generated by Image Acquisition 01</c>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[2,1]" as_ord="1">read_image (Image, 'D:/Template/Template-281.bmp')</l>
<l>draw_circle (3600, Row, Column, Radius)</l>
<l>gen_circle_contour_xld (ContCircle, Row, Column, Radius, 0, 6.28318, 'positive', 1)</l>
<c></c>
<l>create_shape_model_xld (ContCircle, 'auto', -0.39, 0.79, 'auto', 'auto', 'ignore_local_polarity', 5, ModelID1)</l>
<l>read_image (Image1, 'D:/Template/Template-449.bmp')</l>
<l>find_shape_model (Image1, ModelID1, -0.39, 0.78, 0.5, 1, 0.5, 'least_squares', 0, 0.9, Row1, Column1, Angle,Score)</l>
<l>smin := (Radius - 20) / Radius</l>
<l>smax :=(Radius + 20) / Radius</l>
<c></c>
<l>find_scaled_shape_model (Image1, ModelID1,-0.39, 0.78, smin, smax,0.5, 1, 0.1, 'least_squares', 0, 0.9, Row3, Column3, Angle1, Scale, Score1)</l>
<c></c>
<c>* 遍历匹配结果并绘制匹配到的圆</c>
<l>for Index := 0 to |Row3| - 1 by 1</l>
<c>    * 根据匹配到的中心和角度生成圆轮廓</c>
<l>    gen_circle_contour_xld(CircleContour, Row3[Index], Column3[Index], Scale[Index] * Radius, 0, 2*3.14, 'positive', 1) </l>
<l>endfor</l>
<c></c>
<c></c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
