<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.1" halcon_version="12.0">
<procedure name="main">
<interface/>
<body>
<l>read_image(Image, 'C:/Users/SomeBody/Desktop/decode/FPC/Template-1-3.jpg')</l>
<l>dev_close_window ()</l>
<l>rgb1_to_gray (Image, GrayImage)</l>
<l>scale_image (GrayImage, ImageScaled, 2.57576, 0)</l>
<l>auto_threshold (ImageScaled, Regions, 5)</l>
<l>opening_rectangle1(Regions, ImageOpened, 5, 5)</l>
<c></c>
<l>connection (Regions, ConnectedRegions)</l>
<l>get_image_size (GrayImage, Width, Height)</l>
<l>*region_to_bin (ConnectedRegions, BinImage, 0, 255, Width, Height)</l>
<l>*edges_sub_pix (BinImage, Edges, 'canny', 1, 5, 10)</l>
<l>gen_contour_region_xld (ConnectedRegions, Contours, 'border')</l>
<c>*亚像素边缘</c>
<l>select_shape_xld (Contours, SelectedXLD2, 'circularity', 'and', 0.5, 1.0)</l>
<c></c>
<l>fit_circle_contour_xld (SelectedXLD2, 'algebraic', -1, 0, 0, 3, 2, Row1, Column1, Radius1, StartPhi1, EndPhi1, PointOrder1)</l>
<c></c>
<c>* 假设xld_handle是你想要遍历的XLD对象</c>
<l>count_obj(SelectedXLD2, Number)</l>
<l>for I := 1 to Number by 1</l>
<l>    select_obj(SelectedXLD2, xld, I)</l>
<c>    * 对Object进行操作，例如显示或处理</c>
<l>    gen_circle_contour_xld (xld, Row1[I], Column1[I], Radius1[I], StartPhi1[I], EndPhi1[I], PointOrder1[I], 1)</l>
<l>endfor</l>
<c></c>
<c></c>
<l>gen_circle_contour_xld (ContCircle, 0, 0, 50, 0, 6.28318, 'positive', 1)</l>
<l>scale_image (GrayImage, ImageScaled1, 2.55, 0)</l>
<l>create_scaled_shape_model_xld (ContCircle, 'auto', -0.39, 0.79, 'auto', 0.9, 1.1, 'auto', 'auto', 'ignore_local_polarity', 5, ModelID1)</l>
<c></c>
<l>create_shape_model (GrayImage, 'auto', -0.39, 0.79, 'auto', 'auto', 'use_polarity', 'auto', 'auto', ModelID)</l>
<l>find_shape_model (GrayImage, ModelID, -0.39, 0.78, 0.5, 1, 0.5, 'least_squares', 0, 0.9, Row, Column, Angle, Score)</l>
<c></c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
